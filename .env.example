# ==========================================
# SysAIdmin Manager Environment Variables
# ==========================================

# ==========================================
# CORE SERVICES (Required)
# ==========================================

# Azure OpenAI Configuration (Required)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# MongoDB Configuration (Required)
MONGO_DB_URI=mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
SYSAIDMIN_DB_NAME=sysaidmin
CHECKPOINT_COLLECTION_NAME=checkpoints

# Prometheus Configuration (Required)
PROMETHEUS_ADDRESS=http://localhost:9090
MANAGER_API_ADDRESS=localhost:9123

# ==========================================
# TASK PROCESSING & MESSAGING
# ==========================================

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379

# Slack Integration (Optional)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_CHANNEL=project-harbinger

# ==========================================
# EXTERNAL INTEGRATIONS
# ==========================================

# GitHub Integration (Required for GraphMCP workflows)
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_personal_access_token
GH_TOKEN=ghp_your_github_personal_access_token

# Confluence Integration (Required for Confluence tools)
CONFLUENCE_URL=https://your-domain.atlassian.net
CONFLUENCE_USERNAME=your-email@domain.com
CONFLUENCE_API_TOKEN=your_confluence_api_token
CONFLUENCE_TIMEOUT=30

# Jira Integration (Required for Jira tools)
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@domain.com
JIRA_API_TOKEN=your_jira_api_token

# ==========================================
# MICROSERVICES ENDPOINTS
# ==========================================

# Internal Service URLs
DB_INCIDENT_ASSISTANT_RESPONSE_ENDPOINT=http://localhost:8001/response
CMD_EXEC_ENDPOINT=http://localhost:8002
COMMUNICATION_ENDPOINT=http://localhost:8003
MANAGER_ENDPOINT=http://localhost:9123
DB_SERVERS_CMDB_ENDPOINT=http://localhost:8004
CMDB_API_URL=http://localhost:8001
CMD_EXEC_RESPONSE_ENDPOINT=http://localhost:8002/response

# ==========================================
# AZURE SERVICES (Optional)
# ==========================================

# Azure Service Principal (for KeyVault access)
SPN_TENANT_ID=your_azure_tenant_id
SPN_CLIENT_ID=your_azure_client_id
SPN_PSWD=your_azure_client_secret

# ==========================================
# AI & SEARCH SERVICES
# ==========================================

# Vector Database Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=/tmp/chroma_db

# Web Search (Optional)
TAVILY_TOKEN=your_tavily_api_token

# LangFuse Observability (Optional)
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_HOST=https://cloud.langfuse.com

# ==========================================
# GRAPHMCP FRAMEWORK
# ==========================================

# GraphMCP Logging Configuration
GRAPHMCP_LOG_FILE=dbworkflow.log
GRAPHMCP_OUTPUT_FORMAT=dual
GRAPHMCP_CONSOLE_LEVEL=INFO
GRAPHMCP_FILE_LEVEL=DEBUG
GRAPHMCP_MAX_FILE_SIZE_MB=100
GRAPHMCP_BACKUP_COUNT=5
GRAPHMCP_JSON_PRETTY=false
GRAPHMCP_STRUCTURED_DATA_ENABLED=true

# ==========================================
# DEVELOPMENT & TESTING
# ==========================================

# Test Configuration
TEST_SPACE_KEY=TESTSPACE
CONFLUENCE_TEST_SPACE=TEST
CONFLUENCE_TEST_PAGE_ID=123456
CONFLUENCE_TEST_PAGE_TITLE=Test Runbook
TEST_API_HOST=127.0.0.1
TEST_API_PORT=8005
TEST_LOG_LEVEL=INFO

# Development Settings
DATABASE_URL=sqlite:///local.db
METRICS_DIR=metrics

# ==========================================
# ENVIRONMENT SETTINGS
# ==========================================

# Deployment Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Security
ENABLE_CORS=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# Performance
MAX_WORKERS=4
REQUEST_TIMEOUT=300
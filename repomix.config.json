{
  "output": {
    "filePath": "manager-codebase.xml",
    "style": "xml",
    "headerText": "SysAIdmin Manager - AI-powered system administration platform backend API",
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true
  },
  "include": [
    "**/*.py",
    "**/*.yaml",
    "**/*.yml",
    "**/*.json",
    "**/*.toml",
    "**/*.md",
    "**/*.txt",
    "**/*.sql",
    "**/*.sh",
    "**/Dockerfile",
    "**/Containerfile",
    "**/Makefile",
    "**/pytest.ini",
    "**/conftest.py",
    "pyproject.toml",
    "uv.lock",
    "docker-compose.yaml",
    "main.py",
    "worker_main.py",
    "slack_main.py"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/__pycache__/**",
      "**/*.pyc",
      "**/*.pyo",
      "**/*.pyd",
      "**/.pytest_cache/**",
      "**/htmlcov/**",
      "**/.coverage",
      "**/coverage.xml",
      "**/*.egg-info/**",
      "**/dist/**",
      "**/build/**",
      "**/.venv/**",
      "**/venv/**",
      "**/.env",
      "**/secrets.toml",
      "**/*.log",
      "**/logs/**",
      "**/.DS_Store",
      "**/.idea/**",
      "**/.vscode/**",
      "**/*.iml",
      "**/*.ipr",
      "**/*.iws",
      "**/=*",
      "**/test-results-*.xml",
      "**/repomix-output.xml",
      "**/manager-codebase.xml",
      "**/tmp/**",
      "**/temp/**",
      "**/cache/**",
      "**/*.pkl",
      "**/*.tar.gz",
      "**/chroma/**",
      "**/chroma.sqlite3",
      "**/*_real_repo_pack.xml",
      "**/*_mock_*.json",
      "**/*_mock_*.xml",
      "**/postgres-sample-dbs_repo_pack.xml",
      "**/graphmcp.egg-info/**",
      "**/src/frameworks/graphmcp/tests/data/**",
      "**/src/tools/confluence/chroma/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "processing": {
    "compress": false,
    "maxFileSize": "1MB",
    "maxTotalSize": "50MB"
  }
}